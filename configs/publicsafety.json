{
  "settings": {
    "max_workers": 6,
    "request_delay": 0.3,
    "timeout_seconds": 30
  },
  "sitemaps": [  
    {
      "url": "https://www.publicsafety.gc.ca/sitemapeng.axd",
      "language": { "type": "suffix", "value": "-en.aspx" },
      "url_transform": {
        "force_https": true,
        "force_www": true
      },
      "include_prefixes": [],
      "exclude_prefixes": [
        "https://www.publicsafety.gc.ca/cnt/rsrcs/pblctns/",
        "https://www.publicsafety.gc.ca/cnt/nws/",
        "https://www.publicsafety.gc.ca/cnt/trnsprnc/",
        "https://www.publicsafety.gc.ca/cnt/rsrcs/svc-stndrds-tpp/"
      ]
    }
  ],
  "checks": [
    { "name": "Broken Links", "type": "link_check" }
  ],
  "output": {
    "file": "output/ps_broken_links.xlsx",
    "only_errors": true
  }
}
